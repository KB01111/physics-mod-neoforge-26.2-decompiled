#GLSL_VERSION

// One invocation per particle.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ------------------------------------------------------------
// Particle layout (std430)
// ------------------------------------------------------------
// Matches Java uploadParticlesToSsbo() (32 bytes):
//   vec4  posRad;     // xyz = world position, w = radiusWorld
//   float addScale;   // addByteScale
//   uint  id;         // stable id/seed
//   uint  lightCoord; // packed lightmap coords (lower 16 = u, upper 16 = v)
//   uint  _pad0;
struct Particle {
    vec4  posRad;
    float addScale;
    uint  id;
    uint  lightCoord;
    uint  _pad0;
};

layout(std430, binding = 0) readonly buffer ParticlesBuf {
    Particle P[];
};

// Flat per-cascade metadata buffer, 8 uints per cascade.
// [0] occupied flag
// [1..3] maxXYZ
// [4..6] invMinXYZ = (grid-1)-minXYZ
// [7] reserved
layout(std430, binding = 1) buffer CascadeMetaBuf {
    uint meta[];
};

const uint META_STRIDE = 8u;

uniform int uCascadeIndex;
uniform int uParticleCount;

// ------------------------------------------------------------
// Cascade params
// ------------------------------------------------------------
uniform vec3  uBoundsMin;
uniform vec3  uBoundsSize;
uniform ivec3 uGridSize;     // GRID_X/Y/Z
uniform vec3  uCellSize;     // uBoundsSize / uGridSize

// Occupancy packing
uniform int   uBrickShift;   // log2(BRICK) for brick = voxel >> brickShift

// Noise (coarse voxel blocks)
uniform int   uNoiseShift;   // 2 recommended (block size = 1<<shift)
uniform float uNoiseMinMul;  // 0.20
uniform float uNoiseMaxMul;  // 0.80

// ------------------------------------------------------------
// Lightmap sampling (optional)
// ------------------------------------------------------------
uniform sampler2D uLightMap; // bound to texture unit 0
uniform int       uHasLightMap;
uniform vec3      uFireSmokeColor;
uniform vec3      uSteamSmokeColor;

// Accumulators
layout(r32ui, binding = 0) uniform uimage3D uDensityAcc; // per-voxel sum
layout(r32ui, binding = 1) uniform uimage3D uOccMask;    // packed 2x2x2 brick masks in low 8 bits
layout(r32ui, binding = 2) uniform uimage3D uLightAcc;   // packed (lum8<<24 | r8<<16 | g8<<8 | b8)

// ------------------------------------------------------------
// Hash / noise
// ------------------------------------------------------------
uint hash_u32(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float hash3f01(ivec3 p, uint seed) {
    uint h = uint(p.x) * 73856093u
           ^ uint(p.y) * 19349663u
           ^ uint(p.z) * 83492791u
           ^ seed * 264435761u;
    h = hash_u32(h);
    return float(h & 0x00FFFFFFu) / 16777216.0; // [0,1)
}

// ------------------------------------------------------------
// Helpers
// ------------------------------------------------------------
float fastExp(float x) {
    // GPU exp2 is often faster than exp. exp(x) = exp2(x * 1/ln2)
    const float INV_LN2 = 1.4426950408889634;
    return exp2(x * INV_LN2);
}

vec3 sample_lightmap(ivec2 uv) {
    vec2 base = vec2(0.5 / 16.0);
    vec2 st = clamp((vec2(uv) / 256.0) + base, base, vec2(15.5 / 16.0));
    return texture(uLightMap, st).rgb;
}


uint smoke_style_for_particle(uint id) {
    return (id >> 24) & 0xFFu;
}

vec3 smoke_color_for_particle(uint id) {
    uint style = smoke_style_for_particle(id);
    return (style == 1u) ? uSteamSmokeColor : uFireSmokeColor;
}

uint pack_light_lum24(vec3 rgb) {
    rgb = clamp(rgb, 0.0, 1.0);
    uvec3 c = uvec3(rgb * 255.0 + 0.5);
    float lum = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
    uint lum8 = uint(clamp(lum, 0.0, 1.0) * 255.0 + 0.5);
    return (lum8 << 24) | (c.r << 16) | (c.g << 8) | c.b;
}

void updateCascadeMeta(ivec3 lo, ivec3 hi) {
    uint base = uint(uCascadeIndex) * META_STRIDE;

    atomicOr(meta[base + 0u], 1u);
    atomicMax(meta[base + 1u], uint(hi.x));
    atomicMax(meta[base + 2u], uint(hi.y));
    atomicMax(meta[base + 3u], uint(hi.z));

    atomicMax(meta[base + 4u], uint((uGridSize.x - 1) - lo.x));
    atomicMax(meta[base + 5u], uint((uGridSize.y - 1) - lo.y));
    atomicMax(meta[base + 6u], uint((uGridSize.z - 1) - lo.z));
}

void main() {
    uint pid = gl_GlobalInvocationID.x;
    if (pid >= uint(uParticleCount)) return;

    Particle p = P[pid];

    vec3  wp     = p.posRad.xyz;
    float radius = p.posRad.w;

    // ---- quick reject: cascade AABB expanded by radius ----
    vec3 bmin = uBoundsMin;
    vec3 bmax = uBoundsMin + uBoundsSize;

    if (wp.x < bmin.x - radius || wp.x > bmax.x + radius) return;
    if (wp.y < bmin.y - radius || wp.y > bmax.y + radius) return;
    if (wp.z < bmin.z - radius || wp.z > bmax.z + radius) return;

    // ---- convert to grid space (voxel coordinates) ----
    vec3 invCell = 1.0 / max(uCellSize, vec3(1e-12));
    vec3 pGrid   = (wp - bmin) * invCell; // in voxel units

    // center voxel (clamped)
    ivec3 c = ivec3(clamp(floor(pGrid), vec3(0.0), vec3(uGridSize) - vec3(1.0)));

    // conservative radius in voxels (ceil), at least 1
    ivec3 rV;
    rV.x = max(int(ceil(radius * invCell.x)), 1);
    rV.y = max(int(ceil(radius * invCell.y)), 1);
    rV.z = max(int(ceil(radius * invCell.z)), 1);

    ivec3 lo = max(c - rV, ivec3(0));
    ivec3 hi = min(c + rV, uGridSize - ivec3(1));

    // Conservative per-cascade GPU metadata update.
    // This is based on the particle write bounds, so it stays on-GPU and avoids CPU readback.
    updateCascadeMeta(lo, hi);

    float r2 = radius * radius;

    float sigma = radius * 0.5;
    if (sigma < 1e-6) return;
    float inv2Sigma2 = 1.0 / (2.0 * sigma * sigma);

    // ------------------------------------------------------------
    // Lightmap: sample once per particle (not per voxel)
    // ------------------------------------------------------------
    bool useLight = (uHasLightMap != 0);
    uint packedLight = 0u;
    if (useLight) {
        ivec2 uv = ivec2(int(p.lightCoord & 0xFFFFu), int((p.lightCoord >> 16) & 0xFFFFu));
        uint smokeStyle = smoke_style_for_particle(p.id);
        float fireFactor = (smokeStyle == 1u) ? 0.0 : (float(uv.x) / 256.0);
        
        vec3 rgb = sample_lightmap(uv);
		
		rgb = mix(rgb, vec3(1.0, 0.67, 0.4), pow(fireFactor, 2.0) * 0.6);
        rgb *= smoke_color_for_particle(p.id);
        
        packedLight = pack_light_lum24(rgb);
    }

    // ------------------------------------------------------------
    // OPT 1) Occupancy: DO NOT update per-voxel.
    //       Mark packed 2x2x2 BRICK groups once, outside the voxel loop.
    //       This removes massive atomic contention from inner loops.
    // ------------------------------------------------------------
    ivec3 loBrick = lo >> uBrickShift;
    ivec3 hiBrick = hi >> uBrickShift;

    for (int bz = loBrick.z; bz <= hiBrick.z; ++bz) {
        for (int by = loBrick.y; by <= hiBrick.y; ++by) {
            for (int bx = loBrick.x; bx <= hiBrick.x; ++bx) {
                ivec3 brick = ivec3(bx, by, bz);
                ivec3 group = brick >> 1;
                uint bit = uint((brick.x & 1) | ((brick.y & 1) << 1) | ((brick.z & 1) << 2));
                imageAtomicOr(uOccMask, group, 1u << bit);
            }
        }
    }

    // ------------------------------------------------------------
    // OPT 2) Tighten loops using sphere math per-slice/per-row:
    //       - For each z, shrink y range
    //       - For each (z,y), shrink x range
    //       This cuts voxel iterations a LOT for larger radii.
    //
    // OPT 3) Early-out rows whose MAX possible contribution < 0.5 (=> inc==0)
    //
    // OPT 4) Noise hashing amortized over coarse blocks in X (1<<uNoiseShift)
    // ------------------------------------------------------------
    int nShift = max(uNoiseShift, 0);
    int nStep  = 1 << nShift;               // block size in voxels

    int relY;
    int relZ;

    for (int z = lo.z; z <= hi.z; ++z) {
        float dzGrid = (float(z) + 0.5) - pGrid.z;
        float dzW    = dzGrid * uCellSize.z;
        float dz2    = dzW * dzW;

        float remZ = r2 - dz2;
        if (remZ <= 0.0) continue;

        // Plane early reject: even with dy=0,dx=0
        float wzMax = fastExp(-dz2 * inv2Sigma2);
        if (p.addScale * wzMax * uNoiseMaxMul < 0.5) continue;

        // shrink y-range for this z
        float dyMaxW = sqrt(remZ);
        float dyMaxG = dyMaxW * invCell.y;

        int yStart = max(lo.y, int(floor(pGrid.y - dyMaxG)));
        int yEnd   = min(hi.y, int( ceil(pGrid.y + dyMaxG)));

        relZ = (z - c.z) >> nShift;

        for (int y = yStart; y <= yEnd; ++y) {
            float dyGrid = (float(y) + 0.5) - pGrid.y;
            float dyW    = dyGrid * uCellSize.y;
            float dy2    = dyW * dyW;

            float remYZ = remZ - dy2;
            if (remYZ <= 0.0) continue;

            // base gaussian for this (y,z) row (dx=0)
            float baseYZ = fastExp(-(dy2 + dz2) * inv2Sigma2);

            // Row early reject: max wx <= 1.0
            if (p.addScale * baseYZ * uNoiseMaxMul < 0.5) continue;

            // shrink x-range for this (y,z)
            float dxMaxW = sqrt(remYZ);
            float dxMaxG = dxMaxW * invCell.x;

            int xStart = max(lo.x, int(floor(pGrid.x - dxMaxG)));
            int xEnd   = min(hi.x, int( ceil(pGrid.x + dxMaxG)));

            relY = (y - c.y) >> nShift;

            // Process X in coarse noise blocks (amortize hashing)
            int xb = xStart;
            while (xb <= xEnd) {
                int xbEnd = min(xEnd, xb + nStep - 1);

                int relX = (xb - c.x) >> nShift;
                float n  = hash3f01(ivec3(relX, relY, relZ), p.id);
                float mul = mix(uNoiseMinMul, uNoiseMaxMul, n);

                // If even best-case within this block can’t reach 0.5, skip the block.
                if (p.addScale * baseYZ * mul < 0.5) {
                    xb = xbEnd + 1;
                    continue;
                }

                for (int x = xb; x <= xbEnd; ++x) {
                    float dxGrid = (float(x) + 0.5) - pGrid.x;
                    float dxW    = dxGrid * uCellSize.x;
                    float dx2    = dxW * dxW;

                    float d2 = dx2 + dy2 + dz2;
                    if (d2 > r2) continue;

                    // Gaussian weight
                    float w = baseYZ * fastExp(-dx2 * inv2Sigma2);

                    float incF = p.addScale * w * mul + 0.5;
                    uint  inc  = uint(max(incF, 0.0));
                    if (inc == 0u) continue;

                    // Density accumulation (atomic hot spot)
                    imageAtomicAdd(uDensityAcc, ivec3(x, y, z), inc);

                    // Light: store brightest (by luminance) packed color for this voxel.
                    // In practice, particles in the same voxel usually share the same lightCoord.
                    if (useLight) {
                        imageAtomicMax(uLightAcc, ivec3(x, y, z), packedLight);
                    }
                }

                xb = xbEnd + 1;
            }
        }
    }
}